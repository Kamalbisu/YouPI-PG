# ── Required ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/youpi
# Public base URL of the app (used in emails, QR links, payment callbacks)
APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts provider credentials and 2FA secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Random string (>= 16 chars). Pepper for hashed scan IPs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ── Behind a proxy (Render, Nginx, ...) ───────────────────
TRUST_PROXY=true

# ── Email (optional; without SMTP, emails are recorded as SKIPPED and shown in-app) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="YouPI PG <no-reply@example.com>"

# ── Payment providers (optional platform defaults; per-business keys are set in the admin panel) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Development only. MUST be false/unset in production (app refuses to start otherwise). ──
PAYMENT_SIMULATOR_ENABLED=false

# ── Bootstrap admin (used by `npm run db:seed` / `npm run admin:create`) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Admin
