# YOUPI PG - Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your deployment.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- NODE ENVIRONMENT ---
# NODE_ENV is managed by the supervisor: 'production' by `npm start`, 'development' by `npm run dev`.
# NODE_ENV=development

# --- SERVICE PORTS (Strictly Non-Docker Standard Host Topology) ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_WALLET_STORE_PORT=5000

# --- PUBLIC SERVICE URLS ---
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001
BASE_HELP_URL=http://localhost:3000
BASE_DEMO_STORE_URL=http://localhost:5000
# Merchant sites allowed to show the checkout in the youpi.js modal (iframe), comma separated.
# Unset = only the portal's own origin may frame it.

# --- DATABASE CONFIGURATION (PostgreSQL) ---
# Required. PostgreSQL connection string. SQLite is no longer supported.
# For a hosted database (Neon, Supabase, RDS, ...) paste its URL here, usually with ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youpi_pg
# TLS to the database: disable | require | verify-full (or put ?sslmode=... in DATABASE_URL).
# 'require' encrypts the connection without verifying the server certificate; 'verify-full' verifies it
# (optionally set PGSSLROOTCERT to a CA file).
# PGSSLMODE=require
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# Schema is created by versioned files in /migrations. Apply them with: npm run migrate
# The services refuse to start on a database that has not been migrated. Set this to true to have the
# services apply pending migrations themselves at startup (convenient for Docker/local dev):
# YOUPI_AUTO_MIGRATE=true

# --- CRYPTOGRAPHIC SECRETS (Generate using crypto.randomBytes(32).toString('hex')) ---
# Leave these unset to have a random value generated once and stored in data/.secrets/
# (recommended). To set your own, use a random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Master 256-bit encryption key for sensitive records (OAuth tokens, device keys); must be 64 hex chars:
# ENCRYPTION_MASTER_KEY=
# Admin API access is a single bearer token (ADMIN_API_TOKEN, auto-generated when unset).
# JWT_SECRET / INITIAL_ADMIN_* are not read by any service and have been removed.

# --- TIMING & QUEUE ENGINE CONSTANTS ---
# Payment active window (milliseconds, default 5 minutes = 300000):
PAYMENT_ACTIVE_WINDOW_MS=300000
# Payment processing verification window (milliseconds, default 30 seconds = 30000):
PAYMENT_PROCESSING_WINDOW_MS=30000
# Late observation grace evaluation window (milliseconds, default 30 minutes = 1800000):
LATE_OBSERVATION_WINDOW_MS=1800000

# --- GMAIL OBSERVER CONFIGURATION ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:6003/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS / GOOGLE MESSAGES OBSERVER ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- ANDROID OBSERVER SECURITY ---
# Secret that authorizes device pairing. Leave unset to auto-generate a random one
# (data/.secrets/android_enrollment_secret). Never reuse a value copied from documentation.
# ANDROID_ENROLLMENT_SECRET=
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- RATE LIMITING ---
# Set to true ONLY when the API is reachable solely through a trusted reverse proxy or the
# Cloudflare tunnel: the client address is then read from CF-Connecting-IP / X-Forwarded-For.
# Left unset, the socket address is used (behind a proxy that makes every client share one limit).
# YOUPI_TRUST_PROXY_HEADERS=true
# Per-client / per-account limits. 0 disables a limit. Values shown are the defaults.
# YOUPI_RATE_LIMIT_ANON_PAYMENTS_PER_MIN=60
# YOUPI_RATE_LIMIT_DEVICE_PER_MIN=60
# YOUPI_RATE_LIMIT_CHECK_USER_PER_MIN=60
# YOUPI_RATE_LIMIT_OTP_PER_MOBILE_PER_HOUR=5
# YOUPI_RATE_LIMIT_OTP_PER_IP_PER_HOUR=30
# YOUPI_RATE_LIMIT_AUTH_PER_IP_PER_15MIN=30
# YOUPI_RATE_LIMIT_LOGIN_FAILURES_PER_15MIN=10

# --- WEBHOOK ENGINE ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- CHECKOUT PORTAL FRAMING ---
# frame-ancestors CSP for the checkout page. Unset defaults to * in development
# and 'self' in production (NODE_ENV=production or YOUPI_MODE=production); pin
# it to your storefront origins to prevent clickjacking.
# Origins allowed to frame the checkout page (comma or space separated).
# Only bare http(s) origins are accepted; anything else is ignored.
# CHECKOUT_FRAME_ANCESTORS=https://shop.example.com

# --- WHITE-LABEL BRANDING ---
DEFAULT_APP_NAME="YOUPI PG"
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL="support@youpi.local"
