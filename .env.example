# Copy this file to .env and edit it. Never commit .env.

# PostgreSQL connection string.
# For local development, `npm run db:local` starts a database that matches this default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/youpi

# The address you open in the browser. It MUST match exactly (the app rejects
# requests from any other address): http://localhost:3000 for local development.
APP_URL=http://localhost:3000

# Random string (>= 16 chars). Used to protect OTP codes. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Set to true only when running behind a trusted proxy (Render, Nginx, ...).
TRUST_PROXY=false

# --- Email (Brevo transactional email API) -----------------------------
# Login codes are sent by email. Required in production. When BREVO_API_KEY is
# empty (development), no email is sent: the code is printed in the server
# console instead.
BREVO_API_KEY=
# Sender address. It must be a verified sender (or domain) in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=YouPI PG
# Added to 10-digit mobile numbers (asked for when paying online).
DEFAULT_COUNTRY_CODE=+91

# --- First admin (used by `npm run admin:create`) ------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
# Optional. Defaults to the part of the email before the @.
SEED_ADMIN_USERNAME=

# --- First Admin 2 / auditor (used by `npm run auditor:create`) ----------
# Admin 2 is a read-only role that can see every payment event. You can also
# create these accounts from the admin panel (Admin 2 accounts).
SEED_AUDITOR_EMAIL=
SEED_AUDITOR_PASSWORD=
SEED_AUDITOR_NAME=Admin 2
# Optional. Defaults to the part of the email before the @.
SEED_AUDITOR_USERNAME=

# --- Easebuzz (online payments and refunds) -------------------------------
# Leave EASEBUZZ_KEY/EASEBUZZ_SALT empty and "Pay online" is switched off;
# the QR + transaction-ID flow keeps working.
# Get the test key and salt from the Easebuzz test dashboard (testdash.easebuzz.in).
EASEBUZZ_KEY=
EASEBUZZ_SALT=
# test = testpay.easebuzz.in, prod = pay.easebuzz.in
EASEBUZZ_ENV=test
# A long random string. Easebuzz must send it with every refund webhook:
# either as the header x-webhook-token or as ?token=... on the webhook URL.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EASEBUZZ_WEBHOOK_TOKEN=
# refund = also check the payload hash when the webhook has one (recommended).
# off = rely on the token only. See the README before switching this off.
EASEBUZZ_WEBHOOK_HASH=refund
