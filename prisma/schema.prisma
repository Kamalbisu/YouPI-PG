// YouPI PG - PostgreSQL schema (admin panel + user panel).
// Money (optional QR amounts) is stored as integer paise. Never use floats for money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  AUDITOR // "Admin 2": read-only trace of every payment activity
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  LOGIN // sign in, or create the account when the email is new
  SIGNUP // username + password signup waiting for email verification
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id               String     @id @default(cuid())
  role             UserRole   @default(USER)
  name             String
  username         String     @unique // lower case, 3-30 chars [a-z0-9_]
  email            String?    @unique // lower case; verified by a code for users, set directly for admins
  mobile           String?    @unique // E.164, e.g. +919876543210 (optional, asked for when paying online)
  passwordHash     String? // null for accounts created by OTP login until a password is set
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions          Session[]
  assignments       QrAssignment[]
  transactions      Transaction[]      @relation("TransactionOwner")
  reviewed          Transaction[]      @relation("TransactionReviewer")
  notificationsIn   Notification[]     @relation("NotificationRecipient")
  notificationsSent Notification[]     @relation("NotificationSender")
  notificationReads NotificationRead[]
  qrsCreated        Qr[]
  payments          Payment[]          @relation("PaymentOwner")

  @@index([role, createdAt])
  @@index([status])
  @@map("users")
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique // sha256 of the opaque cookie value
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime // idle expiry (sliding)
  absoluteExpiresAt DateTime
  ip                String?
  userAgent         String?
  revokedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time email codes. Only a salted hash of the code is stored.
model OtpCode {
  id         String     @id @default(cuid())
  email      String // lower case
  purpose    OtpPurpose
  codeHash   String
  payload    Json? // SIGNUP: { name, username, passwordHash }
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String? // username of the actor
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model FileAsset {
  id          String   @id @default(cuid())
  contentType String
  size        Int
  sha256      String
  data        Bytes
  createdById String?
  createdAt   DateTime @default(now())

  qrs Qr[]

  @@map("file_assets")
}

model Qr {
  id          String   @id @default(cuid())
  label       String
  amountPaise Int? // optional fixed amount
  active      Boolean  @default(true)
  forAll      Boolean  @default(false) // shown to every user
  imageId     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image        FileAsset      @relation(fields: [imageId], references: [id])
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments  QrAssignment[]
  transactions Transaction[]

  @@index([active, forAll])
  @@index([createdAt])
  @@map("qrs")
}

model QrAssignment {
  id        String   @id @default(cuid())
  qrId      String
  userId    String
  createdAt DateTime @default(now())

  qr   Qr   @relation(fields: [qrId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([qrId, userId])
  @@index([userId])
  @@map("qr_assignments")
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  qrId         String
  txnId        String            @unique // normalized (upper case) UTR / reference number
  status       TransactionStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  user     User  @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  qr       Qr    @relation(fields: [qrId], references: [id], onDelete: Restrict)
  reviewer User? @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([qrId])
  @@map("transactions")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  userId      String? // null = sent to all users
  createdById String?
  createdAt   DateTime @default(now())

  user      User?              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("NotificationSender", fields: [createdById], references: [id], onDelete: SetNull)
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

enum PaymentMethod {
  EASEBUZZ // online checkout
  QR // QR + transaction id (manual review)
}

enum PaymentStatus {
  CREATED // row written, customer not yet sent to the gateway
  PENDING // sent to the gateway, waiting for the result
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  QUEUED // written to our database, gateway result not known yet
  PROCESSING // gateway accepted, money not yet returned
  PROCESSED
  FAILED
}

enum ActivityActorType {
  USER
  ADMIN
  AUDITOR
  SYSTEM
  GATEWAY
}

/// Online payments through the gateway (Easebuzz). Amounts are integer paise.
model Payment {
  id              String        @id @default(cuid())
  userId          String
  txnId           String        @unique // our merchant transaction id, crypto-random
  amountPaise     Int
  purpose         String
  status          PaymentStatus @default(CREATED)
  method          PaymentMethod @default(EASEBUZZ)
  easebuzzId      String? // gateway's id for the payment
  gatewayMode     String? // card, upi, netbanking...
  failureReason   String?
  paidAmountPaise Int? // what the gateway says was paid
  gatewayResponse Json? // last raw gateway response, secrets removed
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User     @relation("PaymentOwner", fields: [userId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([method, createdAt])
  @@index([easebuzzId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  merchantRefundId String       @unique
  amountPaise      Int
  reason           String?
  status           RefundStatus @default(QUEUED)
  gatewayRefundId  String?
  failureReason    String?
  requestedById    String?
  gatewayResponse  Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Append-only trace of everything that happens between users, admins and the gateway.
/// A database trigger rejects UPDATE and DELETE, and no code path updates or deletes rows.
model ActivityEvent {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  type          String // e.g. "payment.callback.received"
  actorType     ActivityActorType
  actorId       String?
  actorName     String?
  targetUserId  String?
  paymentId     String?
  refundId      String?
  transactionId String? // manual (QR) transaction row id
  paymentRef    String? // payment txnId / manual txn id shown in the UI
  fromStatus    String?
  toStatus      String?
  ip            String?
  userAgent     String?
  metadata      Json?

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([paymentRef])
  @@map("activity_events")
}
