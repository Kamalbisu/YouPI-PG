// YouPI PG - PostgreSQL schema (admin panel + user panel).
// Money (optional QR amounts) is stored as integer paise. Never use floats for money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  LOGIN // sign in, or create the account when the number is new
  SIGNUP // username + password signup waiting for mobile verification
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id               String     @id @default(cuid())
  role             UserRole   @default(USER)
  name             String
  username         String     @unique // lower case, 3-30 chars [a-z0-9_]
  email            String?    @unique // admins only
  mobile           String?    @unique // E.164, e.g. +919876543210 (users only)
  passwordHash     String? // null for accounts created by OTP login until a password is set
  status           UserStatus @default(ACTIVE)
  mobileVerifiedAt DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions          Session[]
  assignments       QrAssignment[]
  transactions      Transaction[]      @relation("TransactionOwner")
  reviewed          Transaction[]      @relation("TransactionReviewer")
  notificationsIn   Notification[]     @relation("NotificationRecipient")
  notificationsSent Notification[]     @relation("NotificationSender")
  notificationReads NotificationRead[]
  qrsCreated        Qr[]

  @@index([role, createdAt])
  @@index([status])
  @@map("users")
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique // sha256 of the opaque cookie value
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime // idle expiry (sliding)
  absoluteExpiresAt DateTime
  ip                String?
  userAgent         String?
  revokedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time SMS codes. Only a salted hash of the code is stored.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String // E.164
  purpose    OtpPurpose
  codeHash   String
  payload    Json? // SIGNUP: { name, username, passwordHash }
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String? // username of the actor
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model FileAsset {
  id          String   @id @default(cuid())
  contentType String
  size        Int
  sha256      String
  data        Bytes
  createdById String?
  createdAt   DateTime @default(now())

  qrs Qr[]

  @@map("file_assets")
}

model Qr {
  id          String   @id @default(cuid())
  label       String
  amountPaise Int? // optional fixed amount
  active      Boolean  @default(true)
  forAll      Boolean  @default(false) // shown to every user
  imageId     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image        FileAsset      @relation(fields: [imageId], references: [id])
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments  QrAssignment[]
  transactions Transaction[]

  @@index([active, forAll])
  @@index([createdAt])
  @@map("qrs")
}

model QrAssignment {
  id        String   @id @default(cuid())
  qrId      String
  userId    String
  createdAt DateTime @default(now())

  qr   Qr   @relation(fields: [qrId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([qrId, userId])
  @@index([userId])
  @@map("qr_assignments")
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  qrId         String
  txnId        String            @unique // normalized (upper case) UTR / reference number
  status       TransactionStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  user     User  @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  qr       Qr    @relation(fields: [qrId], references: [id], onDelete: Restrict)
  reviewer User? @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([qrId])
  @@map("transactions")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  userId      String? // null = sent to all users
  createdById String?
  createdAt   DateTime @default(now())

  user      User?              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("NotificationSender", fields: [createdById], references: [id], onDelete: SetNull)
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}
